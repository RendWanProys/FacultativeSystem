<Window x:Class="FacultativeSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FacultativeSystem.ViewModels"
        xmlns:views="clr-namespace:FacultativeSystem.Views"
        Title="ИС «Факультатив» — Система учета факультативных курсов"
        Width="1280" Height="820"
        MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudentViewModel}">
            <views:StudentView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TeacherViewModel}">
            <views:TeacherView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminViewModel}">
            <views:AdminView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель навигации (только после входа) -->
        <Border Grid.Row="0" Background="#0F172A" Padding="20,12"
                Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="6" Padding="10,5" Margin="0,0,12,0">
                        <TextBlock Text="ИС «Факультатив»" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                    </Border>
                    <TextBlock Text="Учет факультативных занятий и успеваемости" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="6" Padding="10,5" Margin="0,0,10,0">
                        <TextBlock Text="{Binding CurrentRoleBadge}" Foreground="#93C5FD" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                    <TextBlock Text="{Binding CurrentUserDisplay}" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="Выход" Command="{Binding LogoutCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>

        <!-- Нижняя панель уведомлений -->
        <Border Grid.Row="2" Padding="20,10"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#ECFDF5"/>
                    <Setter Property="BorderBrush" Value="#6EE7B7"/>
                    <Setter Property="BorderThickness" Value="0,1,0,0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="#FEF2F2"/>
                            <Setter Property="BorderBrush" Value="#FCA5A5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Command="{Binding DismissStatusCommand}"
                        Background="Transparent" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Padding="8,2"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#065F46"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="#991B1B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>
