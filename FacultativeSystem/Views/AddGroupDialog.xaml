<Window x:Class="FacultativeSystem.Views.AddGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить группу на факультатив"
        Width="560" Height="460"
        MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Добавить группу на факультатив" Style="{StaticResource PageTitleStyle}" FontSize="19"/>
            <TextBlock x:Name="CourseSubtitleText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,3,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Поиск учебной группы (например: ИСП)" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
                         Style="{StaticResource ModernTextBox}" Height="36"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12">
            <Grid>
                <DataGrid x:Name="GroupsGrid" Style="{StaticResource ModernDataGrid}"
                          MouseDoubleClick="GroupsGrid_MouseDoubleClick"
                          SelectionChanged="GroupsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Учебная группа" Binding="{Binding Name}" Width="1.6*" MinWidth="180"/>
                        <DataGridTextColumn Header="Студентов в группе" Binding="{Binding StudentsCount}" Width="135"/>
                        <DataGridTextColumn Header="Курсов" Binding="{Binding CoursesCount}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="EmptyText"
                           Text="Все существующие группы уже привязаны к этому факультативу или не найдено совпадений."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="24" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Отмена" Click="CancelButton_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" MinWidth="100"/>
            <Button x:Name="ConfirmButton" Content="Добавить группу на факультатив" Click="ConfirmButton_Click"
                    Style="{StaticResource SuccessButton}" IsEnabled="False" MinWidth="230"/>
        </StackPanel>
    </Grid>
</Window>
