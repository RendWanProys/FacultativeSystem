<UserControl x:Class="FacultativeSystem.Views.StudentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Кабинет студента" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="{Binding StudentSummary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Обновить данные" Command="{Binding RefreshCommand}"
                    Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
        </Grid>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
            <!-- Вкладка 1: Мои факультативы, пары и оценки -->
            <TabItem Header="Мои факультативы и оценки по парам">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.45*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Список курсов, куда зачислен студент -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Назначенные факультативные курсы" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>

                            <TextBox Grid.Row="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,10"
                                     ToolTip="Поиск среди ваших факультативов"/>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}"
                                      Style="{StaticResource ModernDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Факультатив" Binding="{Binding Title}" Width="2*" MinWidth="170"/>
                                    <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="1.4*" MinWidth="140"/>
                                    <DataGridTextColumn Header="Часы" Binding="{Binding HoursDisplay}" Width="62"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="8" Padding="24" VerticalAlignment="Center" Margin="16"
                                    Visibility="{Binding HasNoCourses, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Вы пока не добавлены ни в один факультатив"
                                               FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Доступ к факультативным курсам и парам открывается после того, как преподаватель или администратор добавит вас в список курса."
                                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Пары (поля) выбранного факультатива и табличка оценок студента -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Visibility="{Binding SelectedCourse, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding SelectedCourse.Title}" Style="{StaticResource SectionTitleStyle}" FontSize="17" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                                    <Border Background="#EFF6FF" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding SelectedCourse.TeacherName, StringFormat='Преподаватель: {0}'}" Foreground="#1D4ED8" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#F1F5F9" CornerRadius="6" Padding="8,4" Margin="0,0,8,0"
                                            Visibility="{Binding SelectedCourseEnrollment, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="{Binding SelectedCourseEnrollment.CourseGroupName, StringFormat='Группа: {0}'}" Foreground="#334155" FontSize="12"/>
                                    </Border>
                                    <Border Background="#ECFDF5" CornerRadius="6" Padding="8,4"
                                            Visibility="{Binding SelectedCourseEnrollment, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="{Binding SelectedCourseEnrollment.GradeDisplay, StringFormat='Итог / Зачёт: {0}'}" Foreground="#065F46" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedCourse.Description}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,12"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Ведомость ваших оценок по парам (нажмите на ячейку для деталей занятия)"
                                       Style="{StaticResource FieldLabelStyle}" FontSize="13" Margin="0,0,0,6"/>

                            <Grid Grid.Row="2">
                                <DataGrid x:Name="StudentMatrixGrid"
                                          ItemsSource="{Binding StudentMatrixRows}"
                                          Visibility="{Binding HasMatrixData, Converter={StaticResource BoolToVis}}"
                                          Background="#FFFFFF"
                                          BorderBrush="#CBD5E1"
                                          BorderThickness="1"
                                          RowBackground="#FFFFFF"
                                          GridLinesVisibility="All"
                                          HorizontalGridLinesBrush="#CBD5E1"
                                          VerticalGridLinesBrush="#CBD5E1"
                                          HeadersVisibility="Column"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionUnit="Cell"
                                          SelectionMode="Single"
                                          FrozenColumnCount="2"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          CanUserResizeColumns="True"
                                          CanUserSortColumns="False"
                                          RowHeight="38"
                                          FontFamily="Segoe UI"
                                          FontSize="13"
                                          SelectedCellsChanged="StudentMatrixGrid_SelectedCellsChanged">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#F1F5F9"/>
                                            <Setter Property="Foreground" Value="#1E293B"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#0F172A"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="BorderBrush" Value="#2563EB"/>
                                                    <Setter Property="Background" Value="#EEF2FF"/>
                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Студент" Binding="{Binding StudentName}" Width="200" MinWidth="150" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="8,0"/>
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="105" MinWidth="80" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="6,0"/>
                                                    <Setter Property="Foreground" Value="#475569"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="Для вашей группы по этому факультативу пока нет добавленных пар."
                                           Visibility="{Binding HasMatrixData, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
                            </Grid>

                            <!-- Детали выбранной пары (видно только при клике на ячейку) -->
                            <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0"
                                    Visibility="{Binding SelectedMatrixCell, Converter={StaticResource NullToVis}}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}">
                                        <Run Text="{Binding SelectedMatrixCell.LessonDate}"/>
                                        <Run Text=" • "/>
                                        <Run Text="{Binding SelectedMatrixCell.LessonType}"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding SelectedMatrixCell.LessonTitle}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0">
                                        <Run Text="Ваша оценка: " FontWeight="SemiBold"/>
                                        <Run Text="{Binding SelectedMatrixCell.GradeDisplayText, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Visibility="{Binding SelectedMatrixCell.LessonNote, Converter={StaticResource NullToVis}}">
                                        <Run Text="Описание пары: " FontWeight="SemiBold"/>
                                        <Run Text="{Binding SelectedMatrixCell.LessonNote}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Visibility="{Binding SelectedMatrixCell.Comment, Converter={StaticResource NullToVis}}">
                                        <Run Text="Комментарий к оценке: " FontWeight="SemiBold"/>
                                        <Run Text="{Binding SelectedMatrixCell.Comment}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0"
                                    Visibility="{Binding SelectedCourseEnrollment.Comment, Converter={StaticResource NullToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Комментарий преподавателя по итогам курса:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding SelectedCourseEnrollment.Comment}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: Сводная ведомость зачётов и оценок -->
            <TabItem Header="Итоговые зачёты и оценки">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Ведомость итоговых оценок и зачётов" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding MyEnrollments}" SelectedItem="{Binding SelectedEnrollment}"
                                      Style="{StaticResource ModernDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Факультатив" Binding="{Binding CourseTitle}" Width="1.5*" MinWidth="180"/>
                                    <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="1.2*" MinWidth="150"/>
                                    <DataGridTextColumn Header="Группа" Binding="{Binding CourseGroupName}" Width="110"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="105"/>
                                    <DataGridTextColumn Header="Зачёт / Оценка" Binding="{Binding GradeDisplay}" Width="130"/>
                                    <DataGridTextColumn Header="Комментарий (заметка)" Binding="{Binding Comment}" Width="2*" MinWidth="200"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Нижний блок виден только при выборе курса в ведомости -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,12,0,0"
                            Visibility="{Binding SelectedEnrollment, Converter={StaticResource NullToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedEnrollment.CourseTitle, StringFormat='Примечание по курсу: {0}'}"
                                       Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding SelectedEnrollment.Comment, TargetNullValue='Комментарий не указан.'}"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
