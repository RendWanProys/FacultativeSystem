<UserControl x:Class="FacultativeSystem.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1.15*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая презентационная панель -->
        <Border Grid.Column="0" Padding="48" Background="#0F172A">
            <StackPanel VerticalAlignment="Center">
                <Border Background="#1E293B" CornerRadius="10" Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,20">
                    <TextBlock Text="Калининградский бизнес-колледж • ИС «Факультатив»"
                               Foreground="#93C5FD" FontSize="12" FontWeight="SemiBold"/>
                </Border>

                <TextBlock Text="Информационная система&#x0a;учета факультативов"
                           Foreground="#FFFFFF" FontSize="30" FontWeight="Bold" LineHeight="38" Margin="0,0,0,16"/>

                <TextBlock Text="Информационная система для управления факультативными курсами, учебными группами, расписанием пар и выставлением оценок и зачетов."
                           Foreground="#94A3B8" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,28"/>

                <Border Background="#1E293B" CornerRadius="10" Padding="18" BorderBrush="#334155" BorderThickness="1"
                        Visibility="{Binding IsDevMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Быстрый вход (DEV-режим):" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12"/>
                        <Button Content="Администратор (admin / admin123)"
                                Command="{Binding QuickDemoAdminCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>
                        <Button Content="Преподаватель (paramonov / 123456)"
                                Command="{Binding QuickDemoTeacherCommand}"
                                Style="{StaticResource SuccessButton}" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>
                        <Button Content="Студент — Габитов Р. Т. (gabitov / 123456)"
                                Command="{Binding QuickDemoStudentCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Правая панель авторизации -->
        <Border Grid.Column="1" Background="#F1F5F9" Padding="48">
            <Border Style="{StaticResource CardBorder}" MaxWidth="440" VerticalAlignment="Center" Padding="32">
                <StackPanel>
                    <TextBlock Text="Вход в ИС «Факультатив»" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,6"/>
                    <TextBlock Text="Введите логин и пароль, выданные администратором"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,22"/>

                    <TextBlock Text="Логин" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Height="38" Margin="0,0,0,14"/>

                    <TextBlock Text="Пароль" Style="{StaticResource FieldLabelStyle}"/>
                    <PasswordBox x:Name="PwdBox" PasswordChanged="PwdBox_PasswordChanged"
                                 Style="{StaticResource ModernPasswordBox}" Height="38" Margin="0,0,0,16"/>

                    <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <Button Content="Войти в систему"
                            Command="{Binding SubmitCommand}"
                            Style="{StaticResource PrimaryButton}" Height="42" FontSize="14" Margin="0,4,0,16"/>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                        <TextBlock Text="Самостоятельная регистрация отключена. Учетные записи пользователей создаются администратором системы, а зачисление на факультативы выполняется преподавателем или администратором."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="17"/>
                    </Border>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
